{
  "manifest_version": 3,
  "name": "GBF Inventory Tracker",
  "version": "0.1.0",
  "description": "Local-first Granblue Fantasy collection tracker and Eternal/Evoker planner.",
  "permissions": [
    "storage",
    "activeTab",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GBF Inventory Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://game.granbluefantasy.jp/*"],
      "js": ["passive-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://game.granbluefantasy.jp/*"],
      "js": ["passive-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://gbf.wiki/*"
  ]
}
