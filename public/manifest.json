{
  "manifest_version": 3,
  "name": "GBF Tracker",
  "version": "0.1.0",
  "description": "Local-first Granblue Fantasy collection tracker and Eternal/Evoker planner.",
  "icons": {
    "16": "icons/icon16.jpg",
    "32": "icons/icon32.jpg",
    "48": "icons/icon48.jpg",
    "128": "icons/icon128.jpg"
  },
  "permissions": [
    "storage",
    "activeTab",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GBF Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.jpg",
      "32": "icons/icon32.jpg",
      "48": "icons/icon48.jpg",
      "128": "icons/icon128.jpg"
    }
  },
  "host_permissions": [
    "https://gbf.wiki/*"
  ]
}
